{
  "expo": {
    "name": "Шагомер",
    "slug": "step-counter",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.stepcounter",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "bluetooth-central"
        ],
        "NSLocationWhenInUseUsageDescription": "Нужна геолокация, чтобы считать расстояние и скорость.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Нужна геолокация, чтобы считать шаги, когда экран выключен.",
        "NSMotionUsageDescription": "Нужен доступ к движению, чтобы считать шаги.",
        "NSBluetoothAlwaysUsageDescription": "Нужен Bluetooth, чтобы получать пульс с датчика."
      }
    },
    "android": {
      "package": "com.example.stepcounter",
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-task-manager",
      [
        "expo-sensors",
        {
          "motionPermission": "Нужен доступ к движению, чтобы считать шаги."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Нужен Bluetooth, чтобы получать пульс с датчика."
        }
      ]
    ],
    "newArchEnabled": false
  }
}